# Supplied data package — real government data, large, never modified by us
Dataset/

# Raw inputs are never committed. In this repo they live in Dataset/raw (ignored
# above); data/raw is kept here so the FRD's layout works if inputs are ever moved.
data/raw/

# Our own generated outputs
data/interim/
data/artifacts/
docs/data_profile.txt

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.env

# Frontend (Phase 9)
node_modules/
frontend/dist/

# Frontend build
frontend/node_modules/
frontend/dist/

# Generated sample output — regenerate with the scripts, do not commit
case_report_sample.pdf
.vscode/

# OCR model weights (Surya, ~1.5 GB) — fetched by scripts/fetch_ocr_models.py, never committed
data/models/

# Live-portal crawl output from ingestion/ — raw API responses, checkpoints, logs (~270 MB).
