# Raw inputs are never committed. In this repo they live in Dataset/raw (ignored
# above); data/raw is kept here so the FRD's layout works if inputs are ever moved.
data/raw/

# Our own generated outputs
data/interim/
docs/data_profile.txt

# Pipeline artifacts ARE committed: the site serves them, and a host that builds from this
# repo has no way to produce them (training needs the raw Dataset and ninety seconds of
# work). What stays out is of three kinds, and the split is the same one `.dockerignore`
# makes for the image:
#   * derived      — the case store rebuilds itself from case_files.json in two seconds;
#   * runtime      — the audit log and the field records belong to the machine that wrote
#                    them, and a committed copy would fork a hash chain that exists to be
#                    unforkable;
#   * not ours     — photographs and documents submitted by officers are evidence, and
#                    publishing them is not a decision a .gitignore should make quietly.
data/artifacts/*.sqlite
data/artifacts/field_photos/
data/artifacts/field_documents/
data/artifacts/ocr_benchmark/
data/artifacts/_tmp_*

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.env

# Frontend (Phase 9)
node_modules/
frontend/dist/

# Frontend build
frontend/node_modules/
frontend/dist/

# Generated sample output — regenerate with the scripts, do not commit
case_report_sample.pdf
.vscode/

# OCR model weights (Surya, ~1.5 GB) — fetched by scripts/fetch_ocr_models.py, never committed
data/models/

# Live-portal crawl output from ingestion/ — raw API responses, checkpoints, logs (~270 MB).
# Regenerable by re-running the crawl; the code that produces it is committed.
data/portal/
